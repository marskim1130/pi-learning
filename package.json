{
  "name": "pi-learning-agent",
  "version": "0.1.0",
  "type": "module",
  "description": "Structured learning interactions for Pi Coding Agent",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "learning",
    "tutor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marskim1130/pi-learning.git"
  },
  "homepage": "https://github.com/marskim1130/pi-learning#readme",
  "bugs": {
    "url": "https://github.com/marskim1130/pi-learning/issues"
  },
  "files": [
    "extension/",
    "web/dist/",
    "README.md",
    "LICENSE"
  ],
  "workspaces": [
    "web"
  ],
  "pi": {
    "extensions": [
      "./extension/index.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "npm --prefix web run typecheck",
    "build:web": "npm --prefix web run build",
    "prepack": "npm run build:web",
    "check": "npm run typecheck && npm run typecheck:web && npm test",
    "e2e": "node tests/e2e-rpc.mjs",
    "e2e:browser": "playwright test",
    "pi": "pi -e ./extension/index.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "overrides": {
    "monaco-editor@0.56.0": {
      "dompurify": "3.4.13"
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.0",
    "@earendil-works/pi-coding-agent": "0.84.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "24.12.4",
    "jsdom": "^30.0.1",
    "typebox": "1.3.7",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
